# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bondkoin?schema=public"
# Also backs pending OTP codes. Unset = in-memory, lost on every restart.
REDIS_URL="redis://localhost:6379"

# ─── Auth & Security ─────────────────────────────────────────
# REQUIRED. The API refuses to start without it — there is no fallback, and
# the two example values that used to live here are rejected explicitly.
# Generate with: openssl rand -hex 32
# Miner and admin tokens are both signed with this key, so leaking it means
# someone can mint an admin token.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Browser origins allowed to call this API, comma separated. Leave unset to
# use the defaults in src/common/cors-origins.ts. Add preview/staging hosts
# here — anything not listed is refused by the browser.
CORS_ORIGINS="https://bondkoinlabs.com,https://www.bondkoinlabs.com,http://localhost:3000"

# Login and withdrawal requests require a mailed OTP in addition to the
# password/session — on every platform, website and mobile app alike (it used
# to be website-only, and a client that left out `platform` skipped it).
# Accounts with an authenticator app (Google 2FA) use its code instead, and
# need it whatever these say. Both require a working SMTP transport (below).
# Set to "false" as an emergency off-switch if mail delivery is down and the
# requirement itself is blocking every login or withdrawal.
LOGIN_OTP_ENFORCED="true"
WITHDRAWAL_OTP_ENFORCED="true"

# Encrypts each miner's authenticator-app (TOTP) secret in the database.
# Generate with: openssl rand -hex 32 — and set it before anyone turns on 2FA.
# Unset, a key derived from JWT_SECRET is used instead, which means rotating
# JWT_SECRET would break every authenticator enrolled until then (those
# miners would need an operator to reset their 2FA from the admin panel).
TOTP_ENCRYPTION_KEY=""

# ─── Chain (BNB Smart Chain) ─────────────────────────────────
# WALLET_MODE: offchain | testnet | mainnet
WALLET_MODE="offchain"
BSC_RPC_URL="https://bsc-dataseed1.binance.org/"
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
BONDKOIN_CONTRACT_ADDRESS=""   # Your BEP-20 token address (required for mainnet payouts)
BONDKOIN_DECIMALS="18"
HOT_WALLET_PRIVATE_KEY=""       # Payout wallet private key — KEEP SECRET, never commit

# ─── Reward Economics ────────────────────────────────────────
BASE_RATE_PER_HOUR="0.9"
POINTS_PER_MAINNET_TOKEN="3"    # 3 points = 1 $BONDKOIN
MIN_WITHDRAWAL_POINTS="100"
WITHDRAWAL_COOLDOWN_DAYS="7"
MINE_CLAIM_COOLDOWN_HOURS="24"

# ─── Anti-Abuse Protection ───────────────────────────────────
# These four are defaults. The admin panel's Security tab can override each
# one, and a value saved there wins until it is reset in the panel — so if a
# number here seems to be ignored, check that tab for an override.
MAX_ACCOUNTS_PER_DEVICE="3"     # Max signups allowed per device fingerprint
MAX_ACCOUNTS_PER_IP="5"         # Max signups allowed per IP address
# Max signups per /24 range, which is what catches a farm renting a block of
# addresses and keeping each one under the per-IP cap. 0 disables it. Set it
# with care: a /24 can be one household, or a mobile carrier with thousands
# of real users behind NAT.
MAX_ACCOUNTS_PER_SUBNET="0"
# "true" refuses withdrawals from accounts without an authenticator app.
# Off by default: on, every miner without one must set it up before withdrawing.
REQUIRE_TOTP_FOR_WITHDRAWAL="false"
# Extra throwaway email domains to refuse at signup, comma separated, on top
# of the bundled disposable-email-domains list. Add a new temp-mail domain
# here the moment it shows up in the logs; a restart picks it up.
BLOCKED_EMAIL_DOMAINS=""
# Cloudflare Turnstile secret key. Set it and the website must pass an
# anti-bot check before signup or password-reset mail is sent; unset, the
# check is skipped entirely. Pair it with NEXT_PUBLIC_TURNSTILE_SITE_KEY in
# the frontend — one without the other either blocks every signup or shows a
# widget nothing verifies. Mobile is unaffected (it sends no `platform: web`).
TURNSTILE_SECRET_KEY=""
# Hostnames a solved captcha may come from, comma separated. The site key is
# public, so without this someone can host the widget on their own page and
# spend the tokens here. Leave empty to skip the check — a wrong list refuses
# every real signup, so set it once the widget is confirmed working.
TURNSTILE_HOSTNAMES="bondkoinlabs.com,www.bondkoinlabs.com"
# `platform` is sent by the client, so gating the captcha on "web" means a
# script that omits the field skips it. Set this to "true" to require a
# solution from every caller. The mobile app cannot solve one yet, so its
# signup, password reset and withdrawal-code requests stop working until it
# ships a widget — turn this on when scripted signups are worth that.
CAPTCHA_ALL_PLATFORMS="false"

# ─── Booster Payments (On-Chain BEP-20 Verification) ─────────
# Your receiving wallet address on BNB Chain. When set, users can buy boosters.
BOOSTER_PAY_TO_ADDRESS="0x8E1A28572f4A0EB9699BCf2a3d93eCa5417Ab96c"
# Accepted token: USDT (1:1 USD) or BNB
BOOSTER_PAY_TOKEN="USDT"
# Official USDT contract address on BNB Smart Chain Mainnet:
BOOSTER_PAY_TOKEN_ADDRESS="0x55d398326f99059fF775485246999027B3197955"
BOOSTER_PAY_TOKEN_DECIMALS="18"
BOOSTER_MIN_CONFIRMATIONS="6"
BOOSTER_RPC_URL="https://bsc-dataseed1.binance.org/"

# ─── Initial Admin Account ───────────────────────────────────
# Created on boot, and re-synced on every boot: change ADMIN_PASSWORD and
# redeploy to rotate it, which also signs out every admin session.
# NEVER put a real value here — this file is public. Every password that has
# ever appeared in it is refused (src/admin/published-passwords.ts).
# Generate one with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""                 # Minimum 12 characters required

# Admin console sign-in needs a 6-digit code, mailed after the password.
# Unset, it goes to the operator inbox built into the code
# (DEFAULT_ADMIN_OTP_RECIPIENTS in src/admin/admin-session.ts) — production
# needs nothing here. Set this to send it somewhere else instead, comma
# separated for more than one; for local development use your own inbox, or
# your sign-in codes land in the operator's.
ADMIN_OTP_EMAIL=""
# Emergency off-switch for the code above, e.g. while SMTP is down. Anything
# but "false" keeps it on.
ADMIN_LOGIN_OTP_ENFORCED="true"
# How long an admin stays signed in. Miner sessions use JWT_EXPIRES_IN.
ADMIN_SESSION_TTL="12h"

# Optional: a super-admin account, created/synced on boot the same way.
# Super admins hold every permission (see src/admin/permissions.ts),
# including CRYPTO_PAYMENT_VIEW — the only role that can see the crypto
# finance module. Leave unset if you don't need one yet; grant an existing
# admin just that one permission instead with:
#   npm run admin:create -- <email> <password> admin CRYPTO_PAYMENT_VIEW
# SUPER_ADMIN_EMAIL="owner@bondkoinlabs.com"
# SUPER_ADMIN_PASSWORD="change-me-min-12-chars"

# ─── Real Email Delivery (Spacemail / Custom Domain SMTP) ────
# Configure your SMTP credentials for real 6-digit OTP delivery on Signup, 2FA, & Password Reset:
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="465"
SMTP_USER="hello@bondkoinlabs.com"
SMTP_PASS="your-spacemail-password"
SMTP_FROM="\"BONDKOIN Labs\" <hello@bondkoinlabs.com>"
# Address mail is sent From. Required for Amazon SES, whose SMTP username is
# not an email address; optional for Spacemail/Gmail, where it defaults to
# SMTP_USER. Must be on a domain verified in SES.
SMTP_FROM_EMAIL="hello@bondkoinlabs.com"

# Amazon SES instead of Spacemail (a mailbox caps sends per hour; SES is built
# for transactional volume). Credentials come from SES → SMTP settings →
# Create SMTP credentials — not your IAM access keys.
# SMTP_HOST="email-smtp.ap-southeast-2.amazonaws.com"
# SMTP_PORT="587"
# SMTP_USER="<SES SMTP username>"
# SMTP_PASS="<SES SMTP password>"

# Social bounties (Tasks & Bounties). Admins can override per task in the admin panel.
WEB_URL=https://bondkoinlabs.com
X_HANDLE=BondKoin
# Full URL of the pinned post to repost, e.g. https://x.com/BondKoin/status/1234567890
X_PINNED_POST_URL=https://x.com/BondKoin
