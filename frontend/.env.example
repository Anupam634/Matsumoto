NEXT_PUBLIC_API_URL="https://api.bondkoinlabs.com/api"
# Cloudflare Turnstile site key — shows the anti-bot check on signup and
# password reset. Leave empty and no widget renders; the backend enforces it
# only when its own TURNSTILE_SECRET_KEY is set, so set both together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# For local dev: NEXT_PUBLIC_API_URL="http://localhost:3001/api"
